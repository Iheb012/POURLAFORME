  GLADE_HOOKUP_OBJECT (window_homepage, lbl_ft_loc, "lbl_ft_loc");
  GLADE_HOOKUP_OBJECT (window_homepage, lbl_ft_tel, "lbl_ft_tel");

  return window_homepage;
}

