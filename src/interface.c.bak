  gtk_widget_set_size_request (hbox_coach_topbar, -1, 50);
  gtk_container_set_border_width (GTK_CONTAINER (hbox_coach_topbar), 6);

  // ========== NOUVEAU - LOGO IMAGE (remplace l'étoile) ==========
  image_logo_coach = create_pixmap(window_dashboard_coach, "gym_logo_48x40.png");
  gtk_widget_show (image_logo_coach);
  gtk_box_pack_start (GTK_BOX (hbox_coach_topbar), image_logo_coach, FALSE, TRUE, 0);
  gtk_widget_set_size_request (image_logo_coach, 48, 40);

  vbox_c_brand = gtk_vbox_new (FALSE, 0);
  gtk_widget_show (vbox_c_brand);
  gtk_box_pack_start (GTK_BOX (hbox_coach_topbar), vbox_c_brand, FALSE, TRUE, 0);

  lbl_c_brand1 = gtk_label_new ("<b><span foreground=\"#CC0000\" size=\"x-small\">POUR LA</span></b>");
