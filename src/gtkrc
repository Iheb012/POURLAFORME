# Style de base pour tous les widgets
style "dark-base"
{
    bg[NORMAL] = "#1E1E1E"
    base[NORMAL] = "#2A2A2A"
    fg[NORMAL] = "#FFFFFF"
    text[NORMAL] = "#FFFFFF"
}

# Style pour les frames
style "dark-frame"
{
    bg[NORMAL] = "#1E1E1E"
    fg[NORMAL] = "#CC0000"
}

# Style pour les enfants des frames (VBox, HBox, etc.)
style "dark-frame-child"
{
    bg[NORMAL] = "#1E1E1E"
    base[NORMAL] = "#2A2A2A"
}

# Style pour les labels
style "dark-label"
{
    fg[NORMAL] = "#FFFFFF"
}

# Style pour les labels des frames (rouge)
style "frame-label-red"
{
    fg[NORMAL] = "#CC0000"
    font_name = "Sans Bold"
}

# Style pour les TextView
style "dark-textview"
{
    base[NORMAL] = "#2A2A2A"
    text[NORMAL] = "#FFFFFF"
    bg[NORMAL] = "#1E1E1E"
}

# Style pour les ScrolledWindow
style "dark-scrolledwindow"
{
    bg[NORMAL] = "#1E1E1E"
    base[NORMAL] = "#2A2A2A"
}

# Application des styles par classe
class "GtkFrame" style "dark-frame"
class "GtkLabel" style "dark-label"
class "GtkTextView" style "dark-textview"
class "GtkScrolledWindow" style "dark-scrolledwindow"
class "GtkVBox" style "dark-base"
class "GtkHBox" style "dark-base"

# Forcer les labels des frames en rouge
widget_class "*.GtkFrame.GtkLabel" style "frame-label-red"

# Style pour le bouton SE CONNECTER (rouge solide)
style "red-solid-button"
{
    bg[NORMAL] = "#CC0000"
    bg[PRELIGHT] = "#FF3333"
    bg[ACTIVE] = "#990000"
    fg[NORMAL] = "#FFFFFF"
    fg[PRELIGHT] = "#FFFFFF"
    fg[ACTIVE] = "#FFFFFF"
}

# Style pour le bouton S'INSCRIRE (or contour, fond transparent)
style "gold-outline-button"
{
    bg[NORMAL] = "#111111"
    bg[PRELIGHT] = "#222222"
    bg[ACTIVE] = "#000000"
    fg[NORMAL] = "#FFD700"
    fg[PRELIGHT] = "#FFEE58"
    fg[ACTIVE] = "#CCAA00"
    base[NORMAL] = "#111111"
    base[PRELIGHT] = "#222222"
    base[ACTIVE] = "#000000"
}

# Application des styles aux boutons spécifiques
widget "window_login.btn_connecter" style "red-solid-button"
widget "window_login.btn_inscrire" style "gold-outline-button"

# Forcer tous les widgets à utiliser le style de base
widget "*" style "dark-base"
